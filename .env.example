# Copy this file to .env and fill in real values before starting the server.
#   copy .env.example .env

# Supabase PostgreSQL connection string (Settings → Database → Connection string → URI)
# Leave empty to use local SQLite (development only)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Adzuna job search (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional: Adzuna country code (us, gb, in, au, ...). Defaults to us.
ADZUNA_COUNTRY=us

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Backend safety limits.
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=10
MAX_TEXT_CHARS=12000
MAX_CODE_CHARS=12000
MAX_JOB_DESCRIPTIONS=10
EXTERNAL_REQUEST_TIMEOUT_SECONDS=8
